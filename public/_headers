# Cloudflare Pages applies these to every response.
# Syntax: a path pattern, then indented headers underneath.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# NOTE: the sha256-… entry in script-src allows the inline Brevo Conversations
# loader in index.html. If that snippet changes AT ALL (even whitespace),
# recompute: python3 -c "import re,hashlib,base64;s=re.search(r'<!-- Brevo.*?<script>(.*?)</script>',open('index.html').read(),re.DOTALL).group(1);print('sha256-'+base64.b64encode(hashlib.sha256(s.encode()).digest()).decode())"


/intel/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Intel app code ships fixes several times a day — don't let browsers sit on
# a 4-hour cached copy (the Pages default). 5 minutes keeps refreshes honest.
/intel/*.js
  Cache-Control: public, max-age=300, must-revalidate
/intel/*.html
  Cache-Control: public, max-age=60, must-revalidate
# Intel DATA (themes.json, prefs, notes, dockets) drives what every page
# renders. With no rule here it fell to heuristic browser caching — hours
# stale — which is why admin toggles looked broken while the files on the
# server were correct (Aug 13-14 2026). no-cache = revalidate every use;
# ETag 304s keep it cheap.
/intel/*.json
  Cache-Control: no-cache

# Vite content-hashes every file under /assets, so the bytes at a given URL
# never change — cache them for a year and skip revalidation entirely. This is
# the biggest repeat-visit / SPA-navigation win and is safe because a code
# change ships a new filename.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Root-level media (images, video, fonts) isn't content-hashed, so cap the
# cache at one day: repeat visitors skip the re-download, but replacing a file
# in place still refreshes within 24h instead of being stuck for a year.
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.avif
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.mp4
  Cache-Control: public, max-age=86400
/*.woff2
  Cache-Control: public, max-age=604800

